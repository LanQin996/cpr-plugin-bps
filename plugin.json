{
  "manifestVersion": 2,
  "name": "bps",
  "displayName": "BPS 原生适配器",
  "publisher": "local",
  "version": "0.2.2",
  "description": "原生实现 BPS OAuth、WebSocket、Responses 和客户端工具协议，不需要本地桥接服务",
  "license": "MIT",
  "engines": { "codex-proxy-rs": ">=3.33.0, <4.0.0" },
  "main": "bin/cpr-plugin-bps",
  "runtime": "trustedProcess",
  "resources": {
    "LICENSE": "text/plain",
    "NOTICE": "text/plain",
    "licenses/bps-local.txt": "text/plain",
    "licenses/codex-proxy-ui.txt": "text/plain",
    "web/index.html": "text/html",
    "web/app.js": "text/javascript",
    "web/app.css": "text/css"
  },
  "contributes": {
    "upstream_adapter": {
      "version": 5,
      "inputFormats": ["openai"],
      "outputFormats": ["openai"]
    },
    "model_catalog": { "version": 2 },
    "command_line": {},
    "management": { "version": 2 }
  },
  "configurationSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "accounts": {
        "title": "BPS 账号",
        "description": "由 BPS 账号管理页面维护，无需手动编辑",
        "type": "array",
        "default": [],
        "minItems": 0,
        "maxItems": 256,
        "items": {
          "type": "object",
          "required": ["accountId", "models"],
          "additionalProperties": false,
          "properties": {
            "accountId": { "title": "宿主 OpenAI URL + Key 账号 ID", "type": "string", "minLength": 1, "maxLength": 256 },
            "label": { "title": "账号名称", "type": "string", "maxLength": 120 },
            "credentialSource": { "title": "凭据来源", "enum": ["independent", "host"], "default": "independent" },
            "models": {
              "title": "有权使用的模型 ID",
              "description": "不会自动探测模型权限，也不会将模型替换为其他模型",
              "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          }
        }
      },
      "hostSelection": {
        "type":"object","additionalProperties":false,
        "properties": {
          "groupIds":{"type":"array","maxItems":256,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":256}},
          "accountIds":{"type":"array","maxItems":256,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":256}}
        }
      }
    }
  },
  "state": [{
    "namespace": "oauth",
    "schemaVersion": 1,
    "schema": { "type": "object" },
    "maximumRecords": 64,
    "maximumBytes": 4194304,
    "maximumValueBytes": 65536,
    "migratesFrom": []
  }]
}
