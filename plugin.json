{
  "manifestVersion": 2,
  "name": "bps",
  "displayName": "BPS 原生适配器",
  "publisher": "local",
  "version": "0.1.0",
  "description": "原生实现 BPS OAuth、WebSocket、Responses 和客户端工具协议，不需要本地桥接服务",
  "license": "MIT",
  "engines": { "codex-proxy-rs": ">=3.33.0, <4.0.0" },
  "main": "bin/cpr-plugin-bps",
  "runtime": "trustedProcess",
  "resources": {
    "LICENSE": "text/plain",
    "NOTICE": "text/plain",
    "licenses/bps-local.txt": "text/plain"
  },
  "contributes": {
    "upstream_adapter": {
      "version": 5,
      "inputFormats": ["openai"],
      "outputFormats": ["openai"]
    },
    "model_catalog": { "version": 2 },
    "command_line": {}
  },
  "configurationSchema": {
    "type": "object",
    "required": ["accounts"],
    "additionalProperties": false,
    "properties": {
      "accounts": {
        "title": "BPS 账号",
        "description": "宿主占位账号与独立 BPS OAuth 对应；通过插件 CLI 登录或导入 OAuth",
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "items": {
          "type": "object",
          "required": ["accountId", "models"],
          "additionalProperties": false,
          "properties": {
            "accountId": { "title": "宿主 OpenAI URL + Key 账号 ID", "type": "string", "minLength": 1, "maxLength": 256 },
            "models": {
              "title": "有权使用的模型 ID",
              "description": "不会自动探测模型权限，也不会将模型替换为其他模型",
              "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          }
        }
      }
    }
  },
  "state": [{
    "namespace": "oauth",
    "schemaVersion": 1,
    "schema": { "type": "object" },
    "maximumRecords": 32,
    "maximumBytes": 2097152,
    "maximumValueBytes": 65536,
    "migratesFrom": []
  }]
}
